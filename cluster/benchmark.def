Bootstrap: docker
From: python:3.12-slim

# Container "client": ambiente Python con le dipendenze del backend.
# Il CODICE non viene copiato dentro l'immagine: si monta `backend/` a runtime
# (bind), cosi' modifiche al codice non richiedono di ricostruire il .sif.
#
# NB: il path SORGENTE di %files e' relativo alla cartella da cui si lancia
#     `apptainer build` -> costruire dalla ROOT del repo (vedi README.md).
# NB2: la destinazione NON deve stare in /tmp: durante %post Apptainer monta il
#     /tmp dell'host sopra quello del container, nascondendo il file. Usiamo /opt.
# Se python:3.12-slim desse errori di build su qualche wheel, usare python:3.12.

%files
    backend/requirements.txt /opt/requirements.txt

%post
    pip install --no-cache-dir -r /opt/requirements.txt

%environment
    export PYTHONUNBUFFERED=1

%runscript
    exec python "$@"
